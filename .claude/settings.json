{
  "$comment": "Project permissions for the test-engineer agent. Only test paths are editable (Edit rules cover Write too); only test/lint commands may run. Deny rules win over allow rules. Paths starting with / are relative to the repository root.",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/backend/tests/**)",
      "Edit(/frontend/src/test/**)",
      "Edit(/frontend/src/**/*.test.ts)",
      "Edit(/frontend/src/**/*.test.tsx)",
      "Edit(/.test-agent/**)",
      "Bash(cd:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mkdir -p .test-agent:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(npx vitest run:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx prettier:*)",
      "Bash(npm run format:check)",
      "Bash(npm run format:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Edit(/backend/app/**)",
      "Edit(/.github/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/SOLUTION.md)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(sudo:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
