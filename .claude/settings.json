{
  "$comment": "Project permissions for the test-engineer agent. Only test paths are writable; only test/lint commands may run. Deny rules win over allow rules.",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(backend/tests/**)",
      "Write(backend/tests/**)",
      "Edit(frontend/src/test/**)",
      "Write(frontend/src/test/**)",
      "Edit(frontend/src/**/*.test.ts)",
      "Write(frontend/src/**/*.test.ts)",
      "Edit(frontend/src/**/*.test.tsx)",
      "Write(frontend/src/**/*.test.tsx)",
      "Edit(.test-agent/**)",
      "Write(.test-agent/**)",
      "Bash(cd:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(npx vitest run:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx prettier:*)",
      "Bash(npm run format:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(mkdir -p .test-agent:*)",
      "Bash(cat:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(backend/app/**)",
      "Write(backend/app/**)",
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(sudo:*)",
      "WebFetch",
      "WebSearch"
    ]
  }
}
